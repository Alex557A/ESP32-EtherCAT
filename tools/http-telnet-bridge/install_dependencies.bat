@echo off
chcp 65001 >nul
REM ============================================================================
REM Установка зависимостей для HTTP-to-Telnet Bridge
REM ESP32 EtherCAT Slave v4
REM ============================================================================

title ESP32 EtherCAT - Установка зависимостей
color 0B

echo ============================================================================
echo Установка зависимостей для Web Server
echo ============================================================================
echo.

REM Получаем путь к директории скрипта
cd /d "%~dp0"

REM Проверка наличия Node.js
where node >nul 2>&1
if %ERRORLEVEL% NEQ 0 (
    echo [ERROR] Node.js не найден!
    echo.
    echo Пожалуйста, установите Node.js:
    echo 1. Откройте https://nodejs.org/
    echo 2. Скачайте LTS версию
    echo 3. Установите с настройками по умолчанию
    echo 4. Перезапустите этот файл
    echo.
    pause
    exit /b 1
)

echo [OK] Node.js найден
node --version
npm --version
echo.

echo [INFO] Установка зависимостей...
echo.

call npm install

if %ERRORLEVEL% NEQ 0 (
    echo.
    echo [ERROR] Ошибка установки зависимостей!
    pause
    exit /b 1
)

echo.
echo ============================================================================
echo [OK] Зависимости успешно установлены!
echo ============================================================================
echo.
pause
